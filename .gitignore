# -------- Docker --------
# Source: https://github.com/github/gitignore (Docker.gitignore)
**/.env
**/.env.local
**/.env.*.local
!.env.example
docker-compose.override.local.yml
docker-compose.local.yml
**/Dockerfile.bak
**/docker-compose.override.bak

# -------- Editors --------
# JetBrains
.idea/
*.iml
*.ipr
*.iws

# VS Code (keep .vscode/ for shared settings)
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# -------- kilo editor — only the agents/ folder is tracked --------
# Track ./kilo/agents (configuration), but never the embedded git repo,
# the node_modules tree, or the kilo scratch files.
**/.git
/.kilo/node_modules/
/.kilo/package.json
/.kilo/package-lock.json
/-home-*.txt

# -------- OS --------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -------- Secrets (defense in depth — never commit) --------
*.pem
*.key
!docker/reverse-proxy/certs/local.key
*.pfx
*.p12
secrets/
.secrets/
*.secrets.json
appsettings.*.local.json
appsettings.Development.json
!appsettings.json
!appsettings.Development.example.json
.env
!.env.example

# -------- Build outputs / OS-specific --------
*.dll
*.exe
*.so
*.dylib
*.o
*.a
*.lib
*.obj

# -------- Test / coverage outputs --------
TestResults/
coverage/
*.coverage
*.coveragexml
*.trx
*.coverage.*.xml

# -------- Logs --------
*.log
logs/
*.log.*

# -------- Devcontainer / Worktree (Phase 9) --------
# Git worktrees live inside the repo under .worktrees/ (never outside).
# Their contents must never be tracked.
.worktrees/
# Generated per-worktree compose override (created by scripts/worktree-up.sh)
# The pattern matches docker-compose.worktree.<slug>.yml but NOT the
# checked-in docker-compose.worktree.template.yml (negated below).
docker/docker-compose.worktree.*.yml
!docker/docker-compose.worktree.template.yml
# Per-worktree env files (created by scripts/worktree-up.sh)
docker/.env.worktree.*
# Per-user resolver shim on Windows when admin is unavailable
.control-easy/
.worktrees/

# CI temp files (created by scripts/verify-ci-local.sh/.ps1; cleaned up on exit)
.tmp-ci-swagger.json
.tmp-ci-dotnet-stages.sh
# BMad workflow runtime artifacts (generated snapshots + Python bytecode)
_bmad/render/
_bmad/scripts/__pycache__/
_bmad/scripts/tests/__pycache__/

