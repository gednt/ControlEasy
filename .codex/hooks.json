{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks/impeccable-agent-hook.cjs",
            "commandWindows": "node scripts/hooks/impeccable-agent-hook.cjs",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks/impeccable-agent-hook.cjs",
            "commandWindows": "node scripts/hooks/impeccable-agent-hook.cjs",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
